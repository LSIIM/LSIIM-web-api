generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(256)
  email        String       @unique @db.VarChar(256)
  password     String       @db.VarChar(256)
  documento    String       @db.VarChar(14)
  isSysAdmin   Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tokens       Token[]
  userProjects UserProject? @relation("UserToUserProject")

  @@map("usuarios")
}

model UserProject {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  projectId      Int
  isProjectAdmin Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User     @relation("UserToUserProject", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_projects")
}

model Token {
  id          String    @id @default(uuid())
  token       String
  type        TokenType
  expires     DateTime
  createdAt   DateTime  @default(now())
  blacklisted Boolean
  userId      Int
  user        User      @relation(fields: [userId], references: [id])

  @@map("tokens")
}

model Patient {
  id              Int                            @id @default(autoincrement())
  name            String
  birthDate       DateTime
  observation     String
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  ativo           Boolean                        @default(true)
  patientProjects PatientProject[]
  projects        PatientProjectSpecialFeature[]
  recordings      Recording[]

  @@map("patients")
}

model PatientProjectSpecialFeature {
  id                     Int      @id @default(autoincrement())
  patientId              Int
  projectId              Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  patientSpecialFeatures Json
  patient                Patient  @relation(fields: [patientId], references: [id])
  project                Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("patient_project_special_features")
}

model PatientProject {
  id        Int      @id @default(autoincrement())
  patientId Int
  projectId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient   Patient  @relation(fields: [patientId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])

  @@map("patient_project")
}

model CamInfo {
  id         Int              @id @default(autoincrement())
  model      String
  isInfraRed Boolean
  framerate  Float?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  videos     RecordingVideo[]
  movesInfo  MoveInfo[]

  @@map("cam_info")
}

model MoveInfo {
  id           Int         @id @default(autoincrement())
  description  String
  projectId    Int
  defaultCamId Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  defaultCam   CamInfo     @relation(fields: [defaultCamId], references: [id])
  project      Project     @relation(fields: [projectId], references: [id])
  recordings   Recording[]

  @@map("moves_info")
}

model Recording {
  id               Int              @id @default(autoincrement())
  ignore           Boolean
  observation      String?
  patientId        Int
  recordingDate    DateTime
  moveId           Int?
  projectId        Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  recordingsVideos RecordingVideo[]
  moveInfo         MoveInfo?        @relation(fields: [moveId], references: [id])
  patient          Patient          @relation(fields: [patientId], references: [id])
  project          Project          @relation(fields: [projectId], references: [id])

  @@map("recordings")
}

model RecordingVideo {
  id                 Int               @id @default(autoincrement())
  projectVideoTypeId Int
  recordingId        Int
  camIdUsed          Int
  file               String?
  camInfo            CamInfo           @relation(fields: [camIdUsed], references: [id])
  projectVideoType   ProjectVideoType  @relation(fields: [projectVideoTypeId], references: [id])
  recording          Recording         @relation(fields: [recordingId], references: [id])
  annotationVideos   AnnotationVideo[]
}

model Project {
  id                             Int                            @id @default(autoincrement())
  projectName                    String
  description                    String
  patientSpecialFetauresTemplate Json?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  ativo                          Boolean                        @default(true)
  eventTypeProjects              EventTypeProject[]
  movesInfo                      MoveInfo[]
  patientProjects                PatientProject[]
  projects                       PatientProjectSpecialFeature[]
  projectSpecialFeatures         ProjectSpecialFeature[]
  projectsVideoTypes             ProjectVideoType[]
  recordings                     Recording[]
  resultTypeProjects             ResultTypeProject[]
  userProjects                   UserProject[]

  @@map("projects")
}

model ProjectSpecialFeature {
  id             Int      @id @default(autoincrement())
  specialFeature Json?
  projectId      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id])

  @@map("project_special_features")
}

model ProjectVideoType {
  id        Int              @id @default(autoincrement())
  isMain    Boolean
  typeName  String
  projectId Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  videos    RecordingVideo[]
  project   Project          @relation(fields: [projectId], references: [id])

  @@map("project_video_type")
}

model AnnotationResult {
  id                 Int              @id @default(autoincrement())
  scalarResult       Float?
  resultTypeId       Int
  resultTypeOptionId Int
  annotationVideoId  Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  annotationVideo    AnnotationVideo  @relation(fields: [annotationVideoId], references: [id])
  result             ResultType       @relation(fields: [resultTypeId], references: [id])
  resultTypeOption   ResultTypeOption @relation(fields: [resultTypeOptionId], references: [id])

  @@map("annotation_results")
}

model AnnotationVideo {
  id               Int                @id @default(autoincrement())
  comment          String?
  recordingVideoId Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  results          AnnotationResult[]
  recordingVideo   RecordingVideo     @relation(fields: [recordingVideoId], references: [id])
  events           AnnotationEvent[]

  @@map("annotation_video")
}

model AnnotationEvent {
  id                  Int               @id @default(autoincrement())
  annotationVideoId   Int
  eventTypeId         Int
  frames              Int[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  eventTypeProjectsId Int?
  annotationType      AnnotationVideo   @relation(fields: [annotationVideoId], references: [id])
  eventType           EventType         @relation(fields: [eventTypeId], references: [id])
  eventTypeProjects   EventTypeProject? @relation(fields: [eventTypeProjectsId], references: [id])

  @@map("annotations")
}

model EventType {
  id                Int                @id @default(autoincrement())
  name              String
  description       String
  isTemporal        Boolean
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  ativo             Boolean            @default(true)
  annotations       AnnotationEvent[]
  eventsTypeProject EventTypeProject[]

  @@map("event_type")
}

model EventTypeProject {
  id          Int               @id @default(autoincrement())
  projectId   Int
  eventTypeId Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  annotations AnnotationEvent[]
  eventType   EventType         @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  project     Project           @relation(fields: [projectId], references: [id])

  @@map("event_type_projects")
}

model ResultTypeOption {
  id           Int                @id @default(autoincrement())
  name         String
  description  String
  resultTypeId Int
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  ativo        Boolean            @default(true)
  results      AnnotationResult[]
  resultType   ResultType         @relation(fields: [resultTypeId], references: [id])

  @@map("result_type_options")
}

model ResultType {
  id                 Int                 @id @default(autoincrement())
  name               String
  description        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ativo              Boolean             @default(true)
  results            AnnotationResult[]
  resultTypesOptions ResultTypeOption[]
  resultsTypeProject ResultTypeProject[]

  @@map("result_type")
}

model ResultTypeProject {
  id           Int        @id @default(autoincrement())
  projectId    Int
  resultTypeId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  project      Project    @relation(fields: [projectId], references: [id])
  resultType   ResultType @relation(fields: [resultTypeId], references: [id])

  @@map("result_type_projects")
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}
