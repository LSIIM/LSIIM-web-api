# Port number
PORT=5000

# Postgres URL para o docker
DATABASE_URL="postgresql://prisma:prisma@localhost:5432/lsiim"

# JWT
# JWT secret key
JWT_SECRET=thisisasamplesecret
# Tempo em mínutos para um ACCESS_TOKEN expirar.
JWT_ACCESS_EXPIRATION_MINUTES=300
# empo em dias para um REFRESH_TOKEN expirar.
JWT_REFRESH_EXPIRATION_DAYS=7

# Path to recordings
RECORDINGS_PATH_HOST="D:/drives/lsiim/laprem_dataset/videos" # caminho para a pasta de recordings do ponto de vista do host, ou seja, no seu pc
VIDEOS_PATH="/videos" # path para onde os recordings estão do ponto de vista da aplicação: Caso esteja rodando local, colocar igual ao RECORDINGS_PATH_HOST, se estiver no docker colocar '/videos'
URL_BASE_PATH="http://172.24.207.16:8080"
# RECORDINGS_PATH="D:/Users/lsdeo/Documents/Trabalho/LSIIM/videos"
