// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(256)
  email        String        @unique @db.VarChar(256)
  password     String        @db.VarChar(256)
  documento    String        @db.VarChar(14)
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tokens       Token[]
  UserProjects UserProject[]

  @@map("usuarios")
}

model UserProject {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_projects")
}

model Token {
  id          String    @id @default(uuid())
  token       String
  type        TokenType
  expires     DateTime
  createdAt   DateTime  @default(now())
  blacklisted Boolean
  userId      Int
  user        User      @relation(fields: [userId], references: [id])

  @@map("tokens")
}

model Patient {
  id          Int      @id @default(autoincrement())
  name        String
  birthDate   DateTime
  observation String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recordings             Recording[]
  patientSpecialFeatures PatientProjectSpecialFeature[]
  patientProjects        PatientProject[]

  @@map("patients")
}

model PatientProjectSpecialFeature {
  id                     Int      @id @default(autoincrement())
  specialFeatureTemplate Json
  patientId              Int
  patient                Patient  @relation(fields: [patientId], references: [id])
  projectId              Int
  project                Project  @relation(fields: [projectId], references: [id])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("patient_project_special_features")
}

model PatientProject {
  id        Int      @id @default(autoincrement())
  patientId Int
  patient   Patient  @relation(fields: [patientId], references: [id])
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patient_project")
}

model CamInfo {
  id         Int              @id @default(autoincrement())
  model      String
  isInfraRed Boolean
  framerate  Float?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  //projectVideoTypes ProjectVideoType[]
  videos     RecordingVideo[]
  movesInfo  MoveInfo[]

  @@map("cam_info")
}

model MoveInfo {
  id           Int      @id @default(autoincrement())
  description  String
  projectId    Int
  project      Project  @relation(fields: [projectId], references: [id])
  defaultCamId Int
  defaultCam   CamInfo  @relation(fields: [defaultCamId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recordings Recording[]

  @@map("moves_info")
}

model Recording {
  id            Int       @id @default(autoincrement())
  ignore        Boolean
  observation   String?
  patientId     Int
  patient       Patient   @relation(fields: [patientId], references: [id])
  recordingDate DateTime
  moveId        Int?
  moveInfo      MoveInfo? @relation(fields: [moveId], references: [id])
  projectId     Int
  project       Project   @relation(fields: [projectId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  recordingsVideos RecordingVideo[]

  @@map("recordings")
}

model RecordingVideo {
  id                 Int               @id @default(autoincrement())
  projectVideoTypeId Int
  projectVideoType   ProjectVideoType  @relation(fields: [projectVideoTypeId], references: [id])
  recordingId        Int
  recording          Recording         @relation(fields: [recordingId], references: [id])
  camIdUsed          Int
  camInfo            CamInfo           @relation(fields: [camIdUsed], references: [id])
  annotationVideos   AnnotationVideo[]
}

model Project {
  id                             Int      @id @default(autoincrement())
  projectName                    String
  description                    String
  patientSpecialFetauresTemplate Json
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  projectsVideoTypes            ProjectVideoType[]
  projectSpecialFeatures        ProjectSpecialFeature[]
  patientProjectSpecialFeatures PatientProjectSpecialFeature[]
  movesInfo                     MoveInfo[]
  recordings                    Recording[]
  patientProjects               PatientProject[]
  UserProjects                  UserProject[]
  eventTypeProjects             EventTypeProject[]
  resultTypeProjects            ResultTypeProject[]

  @@map("projects")
}

model ProjectSpecialFeature {
  id             Int      @id @default(autoincrement())
  specialFeature Json
  projectId      Int
  project        Project  @relation(fields: [projectId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("project_special_features")
}

model ProjectVideoType {
  id        Int              @id @default(autoincrement())
  isMain    Boolean
  typeName  String
  projectId Int
  project   Project          @relation(fields: [projectId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  videos    RecordingVideo[]

  @@map("project_video_type")
}

model AnnotationResult {
  id                 Int              @id @default(autoincrement())
  scalarResult       Float?
  resultTypeId       Int
  result             ResultType       @relation(fields: [resultTypeId], references: [id])
  resultTypeOptionId Int
  resultTypeOption   ResultTypeOption @relation(fields: [resultTypeOptionId], references: [id])
  annotationVideoId  Int
  annotationVideo    AnnotationVideo  @relation(fields: [annotationVideoId], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("annotation_results")
}

model AnnotationVideo {
  id               Int                @id @default(autoincrement())
  comment          String?
  recordingVideoId Int
  recordingVideo   RecordingVideo     @relation(fields: [recordingVideoId], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  events           AnnotationEvent[]
  results          AnnotationResult[]

  @@map("annotation_video")
}

model AnnotationEvent {
  id                  Int               @id @default(autoincrement())
  annotationVideoId   Int
  annotationType      AnnotationVideo   @relation(fields: [annotationVideoId], references: [id])
  eventTypeId         Int
  eventType           EventType         @relation(fields: [eventTypeId], references: [id])
  frames              Int[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  eventTypeProjects   EventTypeProject? @relation(fields: [eventTypeProjectsId], references: [id])
  eventTypeProjectsId Int?

  @@map("annotations")
}

model EventType {
  id                 Int                @id @default(autoincrement())
  name               String
  description        String
  isTemporal         Boolean
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  annotations        AnnotationEvent[]
  eventTypesProjects EventTypeProject[]

  @@map("event_type")
}

model EventTypeProject {
  id          Int               @id @default(autoincrement())
  projectId   Int
  project     Project           @relation(fields: [projectId], references: [id])
  eventTypeId Int
  eventType   EventType         @relation(fields: [eventTypeId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  annotations AnnotationEvent[]

  @@map("event_type_projects")
}

model ResultTypeOption {
  id           Int                @id @default(autoincrement())
  name         String
  description  String
  resultTypeId Int
  resultType   ResultType         @relation(fields: [resultTypeId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  results      AnnotationResult[]

  @@map("result_type_options")
}

model ResultType {
  id                 Int                 @id @default(autoincrement())
  name               String
  description        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  resultTypesOptions ResultTypeOption[]
  results            AnnotationResult[]
  resultTypeProjects ResultTypeProject[]

  @@map("result_type")
}

model ResultTypeProject {
  id           Int        @id @default(autoincrement())
  projectId    Int
  project      Project    @relation(fields: [projectId], references: [id])
  resultTypeId Int
  resultType   ResultType @relation(fields: [resultTypeId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("result_type_projects")
}

enum Role {
  ADMIN
  USER
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}
